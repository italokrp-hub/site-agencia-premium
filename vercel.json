{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.googletagmanager.com https://www.google-analytics.com https://googleads.g.doubleclick.net https://www.googleadservices.com; script-src-elem 'self' 'unsafe-inline' 'unsafe-eval' https://www.googletagmanager.com https://www.google-analytics.com https://googleads.g.doubleclick.net https://www.googleadservices.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https: https://googleads.g.doubleclick.net https://www.googleadservices.com https://www.googletagmanager.com; connect-src 'self' https: wss: https://googleads.g.doubleclick.net https://www.googleadservices.com https://*.google.com https://*.google.com.br; frame-src 'self' https: https://bid.g.doubleclick.net https://googleads.g.doubleclick.net; object-src 'none'; base-uri 'self';"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/sitemap.xml"
    },
    {
      "source": "/robots.txt",
      "destination": "/robots.txt"
    },
    {
      "source": "/llms.txt",
      "destination": "/llms.txt"
    },
    {
      "source": "/assets/(.*)",
      "destination": "/assets/$1"
    },
    {
      "source": "/images/(.*)",
      "destination": "/images/$1"
    },
    {
      "source": "/passeios-jericoacoara",
      "destination": "/passeios-jericoacoara/index.html"
    },
    {
      "source": "/passeio-lado-leste-jericoacoara",
      "destination": "/passeio-lado-leste-jericoacoara/index.html"
    },
    {
      "source": "/passeio-lado-oeste-jericoacoara",
      "destination": "/passeio-lado-oeste-jericoacoara/index.html"
    },
    {
      "source": "/passeio-buggy-utv-jericoacoara",
      "destination": "/passeio-buggy-utv-jericoacoara/index.html"
    },
    {
      "source": "/transfer-fortaleza-jericoacoara",
      "destination": "/transfer-fortaleza-jericoacoara/index.html"
    },
    {
      "source": "/transfer-aeroporto-jericoacoara",
      "destination": "/transfer-aeroporto-jericoacoara/index.html"
    },
    {
      "source": "/transfer-jijoca-jericoacoara",
      "destination": "/transfer-jijoca-jericoacoara/index.html"
    },
    {
      "source": "/transfer-prea-jericoacoara",
      "destination": "/transfer-prea-jericoacoara/index.html"
    },
    {
      "source": "/roteiro-jericoacoara",
      "destination": "/roteiro-jericoacoara/index.html"
    },
    {
      "source": "/faq",
      "destination": "/faq/index.html"
    },
    {
      "source": "/voucher/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/((?!api/|assets/|images/|sitemap\\.xml|robots\\.txt|llms\\.txt|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
